# Copy to .env for local HTTP runs (scripts read env; .env is NOT auto-loaded — use
# `node --env-file=.env src/http.js` or export the vars yourself).

# --- Kiwi connection (same as the stdio server) ---
KIWI_URL=https://kiwi.sofstica.com:8443
KIWI_USERNAME=your_kiwi_username
KIWI_PASSWORD=your_kiwi_password
# KIWI_INSECURE_TLS=1        # only if the :8443 cert is not trusted by Node

# --- HTTP / remote-connector settings (src/http.js only) ---
# Generate: npm run gen-token
MCP_AUTH_TOKEN=replace-with-64-hex-chars
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
MCP_RATE_PER_MIN=120
# MCP_ALLOW_NO_AUTH=1        # DANGER: disables the token check entirely
